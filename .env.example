# SQLite file, relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Sign session cookies. Use a long random string in any shared environment.
SESSION_SECRET="replace-with-a-long-random-string"

# Optional absolute directory for uploaded surveys and photos.
# UPLOAD_DIR="/var/lib/bellwoods/uploads"

# Shared secret for the inbound email webhook. Not a mailbox password.
# INBOUND_EMAIL_SECRET=

# Optional IMAP polling. Leave blank unless a mailbox is connected.
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# Optional Microsoft 365 / Graph polling. Leave blank until an app registration exists.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAILBOX=
